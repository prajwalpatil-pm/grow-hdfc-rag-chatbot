# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Mistral API key (only needed when GEN_MODE=llm). Get one at https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Model + generation mode
MISTRAL_MODEL=mistral-small-latest
GEN_MODE=llm        # "llm" (uses Mistral) | "template" (fully offline, no key needed)
